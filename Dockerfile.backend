FROM node:22-bookworm-slim

# Install system dependencies:
# - python3, python-is-python3, python3-dev (required by node-gyp for native addons)
# - build-essential (gcc, g++, make required to build better-sqlite3 native C++ module)
# - curl, sqlite3, ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python-is-python3 \
    python3-dev \
    build-essential \
    curl \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHON=/usr/bin/python3 \
    npm_config_python=/usr/bin/python3

WORKDIR /app

# Install Node dependencies for mobile backend (native build supported)
COPY davai-mobile/backend/package*.json ./davai-mobile/backend/
WORKDIR /app/davai-mobile/backend
RUN npm install --omit=dev --no-audit --no-fund

WORKDIR /app

# Copy full application codebase
COPY . .

# Setup directories and permissions
RUN mkdir -p /app/data /app/uploads \
    && chmod +x /app/docker-entrypoint.sh \
    && chmod +x /app/start_server.sh 2>/dev/null || true

# Production Environment Defaults
ENV NODE_ENV=production \
    PORT=4320 \
    HOST=0.0.0.0 \
    DAVAI_DB_PATH=/app/data/davai.db \
    DATA_DIR=/app/data

EXPOSE 4320

ENTRYPOINT ["/bin/sh", "/app/docker-entrypoint.sh"]
